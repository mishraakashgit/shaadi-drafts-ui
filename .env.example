# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.shaadidrafts.com

# Google Analytics 4 measurement ID (leave empty to disable)
NEXT_PUBLIC_GA_ID=

# Enquiry emails via Resend (https://resend.com). Without a key, enquiries are logged on the server
# and the visitor is offered WhatsApp instead.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=shaadidrafts@gmail.com
ENQUIRY_FROM_EMAIL=Shaadi Drafts <enquiries@shaadidrafts.com>
